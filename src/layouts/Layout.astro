---
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  canonical?: string;
  ogType?: string;
  ogImage?: string;
  keywords?: string;
}

const {
  title = "YouTube Playlist Length Calculator - Check & Calculate Duration Online",
  description = "Calculate YouTube playlist length instantly with our free online tool. Check duration at 1.25x, 1.5x, 2x speed, track watched videos & plan your schedule.",
  canonical,
  ogType = "website",
  ogImage = "https://youtubeplaylistlengthcheck.com/og-image.png",
  keywords = "youtube playlist length, youtube playlist length calculator, calculate youtube playlist length, youtube playlist length checker, check youtube playlist length, find youtube playlist length, youtube playlist length calc, how to see youtube playlist length, how to see the length of a playlist on youtube, how long can a youtube playlist be, why can i only see 200 videos in my youtube playlist, what is the ideal length of a playlist, does youtube limit the number of playlists, do youtube playlists count as views, why wont youtube show my full playlist, youtube playlist length finder, youtube playlist length analyzer tool, youtube playlist length calculator online tool, see youtube playlist length, youtube playlist length calculator online, get youtube playlist length",
} = Astro.props;

const siteUrl = "https://youtubeplaylistlengthcheck.com";
const canonicalUrl = canonical || (Astro.url.pathname === '/' || Astro.url.pathname === '' ? siteUrl : `${siteUrl}${Astro.url.pathname.replace(/\/$/, '')}`);
const fullOgImageUrl = ogImage.startsWith('http') ? ogImage : `${siteUrl}${ogImage.startsWith('/') ? ogImage : `/${ogImage}`}`;

const webAppSchema = {
  "@context": "https://schema.org",
  "@type": "WebApplication",
  "name": "YouTube Playlist Length Calculator",
  "alternateName": [
    "YouTube Playlist Length Checker",
    "YouTube Playlist Length Calc",
    "YouTube Playlist Length Finder",
    "YouTube Playlist Length Analyzer Tool"
  ],
  "url": siteUrl,
  "description": description,
  "applicationCategory": "UtilitiesApplication",
  "operatingSystem": "All",
  "browserRequirements": "Requires JavaScript. Requires HTML5.",
  "offers": {
    "@type": "Offer",
    "price": "0",
    "priceCurrency": "USD"
  },
  "featureList": [
    "Calculate YouTube playlist length at 1.0x, 1.25x, 1.5x, 1.75x, and 2.0x playback speed",
    "Check YouTube playlist duration and total video count",
    "Custom video range selector (e.g., video 5 to 25)",
    "Interactive daily study schedule planner with completion date forecasts",
    "Watched video progress tracking with persistent browser memory",
    "Automatic filtering of private, deleted, and unavailable videos"
  ]
};

const webSiteSchema = {
  "@context": "https://schema.org",
  "@type": "WebSite",
  "name": "YouTube Playlist Length Calculator",
  "url": siteUrl,
  "potentialAction": {
    "@type": "SearchAction",
    "target": {
      "@type": "EntryPoint",
      "urlTemplate": "https://youtubeplaylistlengthcheck.com/?list={search_term_string}"
    },
    "query-input": "required name=search_term_string"
  }
};
---

<!doctype html>
<html lang="en" class="scroll-smooth">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
    {/* Favicon & Web Manifest */}
    <link rel="icon" type="image/png" href="/favicon-96x96.png" sizes="96x96" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="shortcut icon" href="/favicon.ico" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <meta name="apple-mobile-web-app-title" content="YtPlaylistLength" />
    <link rel="manifest" href="/site.webmanifest" />
    <meta name="generator" content={Astro.generator} />

    {/* Primary SEO Meta Tags */}
    <title>{title}</title>
    <meta name="title" content={title} />
    <meta name="description" content={description} />
    <meta name="keywords" content={keywords} />
    <meta name="author" content="YouTube Playlist Length Calculator" />
    <meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1" />
    <meta name="theme-color" content="#0F0F0F" id="theme-color-meta" />
    <link rel="canonical" href={canonicalUrl} />

    {/* Inline script to prevent theme flash */}
    <script is:inline>
      (function() {
        try {
          const storedTheme = localStorage.getItem('theme');
          const prefersDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
          if (storedTheme === 'dark' || (!storedTheme && prefersDark)) {
            document.documentElement.classList.add('dark');
            const meta = document.getElementById('theme-color-meta');
            if (meta) meta.setAttribute('content', '#0F0F0F');
          } else {
            document.documentElement.classList.remove('dark');
            const meta = document.getElementById('theme-color-meta');
            if (meta) meta.setAttribute('content', '#FFFFFF');
          }
        } catch (e) {}
      })();
    </script>

    {/* Open Graph / Facebook / LinkedIn */}
    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content="YouTube Playlist Length Calculator" />
    <meta property="og:locale" content="en_US" />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={fullOgImageUrl} />
    <meta property="og:image:secure_url" content={fullOgImageUrl} />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="YouTube Playlist Length Calculator and Analyzer Tool" />

    {/* Twitter Cards */}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:url" content={canonicalUrl} />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={fullOgImageUrl} />
    <meta name="twitter:image:alt" content="YouTube Playlist Length Calculator and Analyzer Tool" />

    {/* Fonts */}
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Geist+Mono:wght@400;500;600&family=Geist:wght@300;400;500;600;700;800&display=swap" rel="stylesheet" />

    {/* JSON-LD Schemas */}
    <script type="application/ld+json" set:html={JSON.stringify(webAppSchema)} />
    <script type="application/ld+json" set:html={JSON.stringify(webSiteSchema)} />
  </head>
  <body class="bg-slate-50 dark:bg-[#0F0F0F] text-slate-900 dark:text-[#F1F1F1] min-h-screen flex flex-col font-sans selection:bg-red-600 selection:text-white transition-colors duration-150">
    <slot />
  </body>
</html>
