---
import { ChevronDown } from 'lucide-react';

const faqs = [
  {
    question: "How do I check YouTube playlist length and calculate total duration?",
    answer: "To check YouTube playlist length, simply copy any YouTube playlist URL (or video link containing &list=) and paste it into the search box above. Our YouTube playlist length calculator online tool queries the official YouTube Data API v3 in paginated batches, converts each video's ISO 8601 duration string into seconds, and aggregates the total watch time instantly."
  },
  {
    question: "How much time do I save when I calculate YouTube playlist length at 1.25x, 1.5x, or 2.0x speed?",
    answer: "Watching at 1.25x speed cuts your watch time by 20% (saving 12 minutes per hour). At 1.5x speed, you save 33.3% of total runtime (20 minutes per hour). At 2.0x speed, you finish in half the time (50% reduction). Our YouTube playlist length calc computes exact time savings down to the second for any custom speed multiplier."
  },
  {
    question: "Can I find YouTube playlist length for a specific range of videos?",
    answer: "Yes! Use the Range & Progress Tracker to set custom start and end video numbers, or pick quick presets like 'First 10', 'First Half', or 'Second Half'. Our YouTube playlist length analyzer tool updates the total duration, speed comparisons, and study projections in real-time exclusively for your selected subset."
  },
  {
    question: "How does the Smart Study & Schedule Planner work?",
    answer: "The study planner offers two flexible modes: 'By Daily Time' allows you to choose your daily study limit (e.g. 45 mins/day) and days per week to project your realistic completion date. 'By Target Deadline' lets you select a calendar target date to calculate the exact minutes you must watch daily at your chosen playback speed."
  },
  {
    question: "Why do some videos say 'Unavailable' or 'Private'?",
    answer: "YouTube allows creators to delete or set individual videos within a public playlist to private. Our engine tags these videos with an 'Unavailable' badge and excludes them from total duration calculations so your time estimates remain 100% accurate."
  },
  {
    question: "Is there a limit on how many videos a playlist can have?",
    answer: "Our backend handles paginated requests up to 1,000 videos per playlist using token-based pagination (`nextPageToken`) and batch processing (`videos.list` up to 50 items per call). This comfortably handles massive courses, tutorials, and music archives."
  },
  {
    question: "Is this YouTube playlist length calculator online tool free to use?",
    answer: "Yes, this YouTube playlist length calculator online tool is 100% free with no registration required. You can check YouTube playlist length immediately with our interactive demo samples or analyze live playlists using the shared key or your own free YouTube Data API v3 key in Settings."
  }
];

const faqJsonLd = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": faqs.map(faq => ({
    "@type": "Question",
    "name": faq.question,
    "acceptedAnswer": {
      "@type": "Answer",
      "text": faq.answer
    }
  }))
};
---

<section id="faq" class="w-full max-w-4xl mx-auto py-8 sm:py-12 px-3.5 sm:px-4 space-y-6 sm:space-y-8 scroll-mt-20">
  <div class="text-center space-y-2 px-2">
    <div class="inline-block text-[11px] sm:text-xs font-mono uppercase tracking-wider text-red-600 dark:text-red-500 font-semibold">
      Help & Knowledge Base
    </div>
    <h2 class="text-xl sm:text-2xl md:text-3xl font-extrabold text-slate-900 dark:text-white tracking-tight">
      Frequently Asked Questions
    </h2>
    <p class="text-xs sm:text-sm text-slate-600 dark:text-[#AAAAAA] max-w-xl mx-auto">
      Everything you need to know about YouTube playlist length calculations, playback speeds, and study scheduling.
    </p>
  </div>

  <div class="space-y-2.5 sm:space-y-3">
    {faqs.map((faq, index) => (
      <details class="group bg-white dark:bg-[#181818] border border-slate-200 dark:border-[#272727] rounded-xl overflow-hidden transition-all duration-200 hover:border-slate-300 dark:hover:border-[#383838] shadow-sm">
        <summary class="flex items-center justify-between p-3.5 sm:p-5 cursor-pointer list-none select-none text-xs sm:text-sm font-semibold text-slate-900 dark:text-white group-open:text-red-600 dark:group-open:text-red-400 touch-manipulation min-h-[44px]">
          <span class="flex items-center gap-2.5 sm:gap-3 text-left">
            <span class="text-[11px] sm:text-xs font-mono text-slate-400 dark:text-[#717171] shrink-0">0{index + 1}</span>
            <span class="leading-snug">{faq.question}</span>
          </span>
          <span class="ml-3 sm:ml-4 shrink-0 transition-transform duration-200 group-open:rotate-180 text-slate-400 dark:text-[#717171]">
            <ChevronDown className="w-4 h-4" />
          </span>
        </summary>
        <div class="px-4 pb-4 sm:px-5 sm:pb-5 text-xs sm:text-sm text-slate-600 dark:text-[#AAAAAA] leading-relaxed border-t border-slate-100 dark:border-[#272727]/60 pt-3">
          {faq.answer}
        </div>
      </details>
    ))}
  </div>

  {/* Structured Data JSON-LD for Search Engines */}
  <script type="application/ld+json" set:html={JSON.stringify(faqJsonLd)} />
</section>
