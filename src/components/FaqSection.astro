---
const faqs = [
  {
    question: "How do I calculate the total length of a YouTube playlist?",
    answer: "Simply copy any YouTube playlist URL (or video link containing &list=) and paste it into the search box above. Our analyzer queries the official YouTube Data API v3 in paginated batches, converts each video's ISO 8601 duration string into seconds, and aggregates the total watch time instantly."
  },
  {
    question: "How much time do I save watching a playlist at 1.25x, 1.5x, or 2.0x speed?",
    answer: "Watching at 1.25x speed cuts your watch time by 20% (you save 12 minutes per hour). At 1.5x speed, you save 33.3% of total runtime (20 minutes per hour). At 2.0x speed, you finish in half the time (50% reduction). Our Playback Speed Matrix computes exact savings down to the second for any custom multiplier."
  },
  {
    question: "Can I calculate the duration for a specific range of videos (e.g. video #10 to #25)?",
    answer: "Yes! Use the Range & Progress Tracker to set custom start and end video numbers, or pick quick presets like 'First 10', 'First Half', or 'Second Half'. The total duration, speed comparisons, and study projections will update in real-time exclusively for your selected subset."
  },
  {
    question: "How does the Smart Study & Schedule Planner work?",
    answer: "The study planner offers two flexible modes: 'By Daily Time' allows you to choose your daily study limit (e.g. 45 mins/day) and days per week to project your realistic completion date. 'By Target Deadline' lets you select a calendar target date to calculate the exact minutes you must watch daily at your chosen playback speed."
  },
  {
    question: "Why do some videos say 'Unavailable' or 'Private'?",
    answer: "YouTube allows creators to delete or set individual videos within a public playlist to private. Our engine tags these videos with an 'Unavailable' badge and excludes them from total duration calculations so your time estimates remain 100% accurate."
  },
  {
    question: "Is there a limit on how many videos a playlist can have?",
    answer: "Our backend handles paginated requests up to 1,000 videos per playlist using token-based pagination (`nextPageToken`) and batch processing (`videos.list` up to 50 items per call). This comfortably handles massive courses, tutorials, and music archives."
  },
  {
    question: "Do I need my own YouTube API key to use this tool?",
    answer: "No, you can test all features immediately with our built-in interactive demo sample playlists. If you analyze custom live playlists and encounter global quota limits, you can easily plug in your own free YouTube Data API v3 key in the Settings modal (it takes under 2 minutes to create in Google Cloud and grants 10,000 free quota units daily)."
  }
];

const faqJsonLd = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": faqs.map(faq => ({
    "@type": "Question",
    "name": faq.question,
    "acceptedAnswer": {
      "@type": "Answer",
      "text": faq.answer
    }
  }))
};
---

<section id="faq" class="w-full max-w-4xl mx-auto py-12 px-4 space-y-8">
  <div class="text-center space-y-2">
    <div class="inline-block text-xs font-mono uppercase tracking-wider text-red-500">
      Help & Knowledge Base
    </div>
    <h2 class="text-2xl sm:text-3xl font-extrabold text-white tracking-tight">
      Frequently Asked Questions
    </h2>
    <p class="text-xs sm:text-sm text-[#AAAAAA]">
      Everything you need to know about YouTube playlist length calculations, playback speeds, and study scheduling.
    </p>
  </div>

  <div class="space-y-3">
    {faqs.map((faq, index) => (
      <details class="group bg-[#181818] border border-[#272727] rounded-xl overflow-hidden transition-all duration-200 hover:border-[#383838]">
        <summary class="flex items-center justify-between p-4 sm:p-5 cursor-pointer list-none select-none text-sm font-semibold text-white group-open:text-red-400">
          <span class="flex items-center gap-3">
            <span class="text-xs font-mono text-[#717171]">0{index + 1}</span>
            <span>{faq.question}</span>
          </span>
          <span class="ml-4 transition-transform duration-200 group-open:rotate-180 text-[#717171]">
            <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
            </svg>
          </span>
        </summary>
        <div class="px-5 pb-5 text-xs sm:text-sm text-[#AAAAAA] leading-relaxed border-t border-[#272727]/60 pt-3">
          {faq.answer}
        </div>
      </details>
    ))}
  </div>

  {/* Structured Data JSON-LD for Search Engines */}
  <script type="application/ld+json" set:html={JSON.stringify(faqJsonLd)} />
</section>

