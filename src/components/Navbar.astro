---
import { Play } from 'lucide-react';
---

<header class="sticky top-0 z-40 w-full border-b border-[#272727] bg-[#0F0F0F]/90 backdrop-blur-md">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 h-16 flex items-center justify-between">
    {/* Brand Logo */}
    <a href="/" class="flex items-center space-x-2.5 group">
      <div class="w-9 h-9 rounded-xl bg-gradient-to-br from-red-500 to-red-700 flex items-center justify-center shadow-lg shadow-red-950/50 group-hover:scale-105 transition-transform">
        <Play className="w-5 h-5 text-white fill-white ml-0.5" />
      </div>
      <div class="flex flex-col">
        <span class="text-sm sm:text-base font-extrabold tracking-tight text-white flex items-center gap-1">
          YT Playlist <span class="text-red-500">Length</span>
        </span>
        <span class="text-[10px] font-mono text-[#AAAAAA] -mt-0.5 tracking-wider uppercase">
          Analyser & Planner
        </span>
      </div>
    </a>

    {/* Navigation links */}
    <nav class="hidden md:flex items-center space-x-6 text-xs font-medium text-[#AAAAAA]">
      <a href="#analyzer" class="hover:text-white transition-colors">Analyzer</a>
      <a href="#features" class="hover:text-white transition-colors">Features</a>
      <a href="#faq" class="hover:text-white transition-colors">FAQ & Guides</a>
    </nav>

    {/* Right actions */}
    <div class="flex items-center space-x-3">
      <a
        href="#analyzer"
        class="px-4 py-1.5 rounded-full bg-red-600 hover:bg-red-500 text-white text-xs font-semibold tracking-wide transition-colors shadow-md shadow-red-950/40"
      >
        Analyze Now
      </a>
    </div>
  </div>
</header>

