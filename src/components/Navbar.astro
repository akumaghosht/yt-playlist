---
import { Play, Sun, Moon, Menu, X, ArrowRight } from 'lucide-react';

const pathname = Astro.url.pathname;
const isHome = pathname === '/' || pathname === '';
const isAbout = pathname === '/about' || pathname === '/about-us';
const isContact = pathname === '/contact' || pathname === '/contact-us';
const isPrivacy = pathname === '/privacy' || pathname === '/privacy-policy';
const isTerms = pathname === '/terms' || pathname === '/terms-and-conditions';
---

<header class="sticky top-0 z-40 w-full border-b border-slate-200 dark:border-[#272727] bg-white/90 dark:bg-[#0F0F0F]/90 backdrop-blur-md transition-colors duration-150">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 h-14 sm:h-16 flex items-center justify-between">
    {/* Brand Logo */}
    <a href="/" class="flex items-center space-x-2 sm:space-x-2.5 group">
      <div class="w-8 h-8 sm:w-9 sm:h-9 rounded-xl bg-gradient-to-br from-red-500 to-red-700 flex items-center justify-center shadow-lg shadow-red-950/20 dark:shadow-red-950/50 group-hover:scale-105 transition-transform shrink-0">
        <Play className="w-4 h-4 sm:w-5 sm:h-5 text-white fill-white ml-0.5" />
      </div>
      <div class="flex flex-col min-w-0">
        <span class="text-sm sm:text-base font-extrabold tracking-tight text-slate-900 dark:text-white flex items-center gap-1 truncate">
          YT Playlist <span class="text-red-600 dark:text-red-500">Length</span>
        </span>
        <span class="text-[9px] sm:text-[10px] font-mono text-slate-500 dark:text-[#AAAAAA] -mt-0.5 tracking-wider uppercase truncate">
          Checker & Planner
        </span>
      </div>
    </a>

    {/* Desktop Navigation links */}
    <nav class="hidden md:flex items-center space-x-6 text-xs font-medium">
      <a
        href={isHome ? '#analyzer' : '/#analyzer'}
        class={`transition-colors ${isHome ? 'text-slate-900 dark:text-white font-semibold' : 'text-slate-600 dark:text-[#AAAAAA] hover:text-slate-900 dark:hover:text-white'}`}
      >
        Analyzer
      </a>
      <a
        href={isHome ? '#features' : '/#features'}
        class="text-slate-600 dark:text-[#AAAAAA] hover:text-slate-900 dark:hover:text-white transition-colors"
      >
        Features
      </a>
      <a
        href="/about"
        class={`transition-colors ${isAbout ? 'text-red-600 dark:text-red-500 font-semibold' : 'text-slate-600 dark:text-[#AAAAAA] hover:text-slate-900 dark:hover:text-white'}`}
      >
        About Us
      </a>
      <a
        href="/contact"
        class={`transition-colors ${isContact ? 'text-red-600 dark:text-red-500 font-semibold' : 'text-slate-600 dark:text-[#AAAAAA] hover:text-slate-900 dark:hover:text-white'}`}
      >
        Contact
      </a>
      <a
        href={isHome ? '#faq' : '/#faq'}
        class="text-slate-600 dark:text-[#AAAAAA] hover:text-slate-900 dark:hover:text-white transition-colors"
      >
        FAQ
      </a>
    </nav>

    {/* Right actions */}
    <div class="flex items-center space-x-2 sm:space-x-3">
      {/* Theme Toggle Button */}
      <button
        id="theme-toggle"
        type="button"
        aria-label="Toggle light and dark mode"
        class="p-2 sm:p-2 rounded-xl border border-slate-200 dark:border-[#272727] bg-slate-100 dark:bg-[#181818] text-slate-700 dark:text-[#AAAAAA] hover:text-slate-900 dark:hover:text-white hover:bg-slate-200 dark:hover:bg-[#222222] transition-colors focus:outline-none focus:ring-2 focus:ring-red-500/40 touch-manipulation min-w-[38px] min-h-[38px] sm:min-w-[40px] sm:min-h-[40px] flex items-center justify-center cursor-pointer"
      >
        <Sun className="w-4 h-4 hidden dark:block text-amber-400" />
        <Moon className="w-4 h-4 block dark:hidden text-slate-700" />
      </button>

      {/* Desktop Analyze CTA */}
      <a
        href={isHome ? '#analyzer' : '/#analyzer'}
        class="hidden sm:inline-flex items-center px-4 py-1.5 rounded-full bg-red-600 hover:bg-red-500 active:bg-red-700 text-white text-xs font-semibold tracking-wide transition-colors shadow-md shadow-red-950/20 dark:shadow-red-950/40"
      >
        Analyze Now
      </a>

      {/* Mobile Hamburger Menu Button */}
      <button
        id="mobile-menu-toggle"
        type="button"
        aria-label="Toggle mobile menu"
        aria-expanded="false"
        class="md:hidden p-2 rounded-xl border border-slate-200 dark:border-[#272727] bg-slate-100 dark:bg-[#181818] text-slate-700 dark:text-[#AAAAAA] hover:text-slate-900 dark:hover:text-white transition-colors min-w-[38px] min-h-[38px] flex items-center justify-center touch-manipulation focus:outline-none focus:ring-2 focus:ring-red-500/40 cursor-pointer"
      >
        <span id="menu-icon-open">
          <Menu className="w-4 h-4" />
        </span>
        <span id="menu-icon-close" class="hidden">
          <X className="w-4 h-4" />
        </span>
      </button>
    </div>
  </div>

  {/* Mobile Navigation Drawer / Dropdown */}
  <div
    id="mobile-menu"
    class="hidden md:hidden border-t border-slate-200 dark:border-[#272727] bg-white/98 dark:bg-[#0F0F0F]/98 backdrop-blur-xl px-4 py-4 space-y-3 animate-in slide-in-from-top-2 duration-150"
  >
    <div class="grid grid-cols-1 gap-1 text-sm font-medium text-slate-700 dark:text-[#AAAAAA]">
      <a
        href={isHome ? '#analyzer' : '/#analyzer'}
        class="mobile-nav-link flex items-center justify-between px-3 py-2 rounded-lg hover:bg-slate-100 dark:hover:bg-[#181818] hover:text-slate-900 dark:hover:text-white transition-colors"
      >
        <span>Playlist Analyzer</span>
        <ArrowRight className="w-3.5 h-3.5 text-slate-400" />
      </a>
      <a
        href={isHome ? '#features' : '/#features'}
        class="mobile-nav-link flex items-center justify-between px-3 py-2 rounded-lg hover:bg-slate-100 dark:hover:bg-[#181818] hover:text-slate-900 dark:hover:text-white transition-colors"
      >
        <span>Features & Speed Matrix</span>
        <ArrowRight className="w-3.5 h-3.5 text-slate-400" />
      </a>
      <a
        href="/about"
        class={`mobile-nav-link flex items-center justify-between px-3 py-2 rounded-lg hover:bg-slate-100 dark:hover:bg-[#181818] hover:text-slate-900 dark:hover:text-white transition-colors ${isAbout ? 'text-red-600 dark:text-red-500 font-semibold bg-red-50/50 dark:bg-red-950/20' : ''}`}
      >
        <span>About Us</span>
        <ArrowRight className="w-3.5 h-3.5 text-slate-400" />
      </a>
      <a
        href="/contact"
        class={`mobile-nav-link flex items-center justify-between px-3 py-2 rounded-lg hover:bg-slate-100 dark:hover:bg-[#181818] hover:text-slate-900 dark:hover:text-white transition-colors ${isContact ? 'text-red-600 dark:text-red-500 font-semibold bg-red-50/50 dark:bg-red-950/20' : ''}`}
      >
        <span>Contact Us</span>
        <ArrowRight className="w-3.5 h-3.5 text-slate-400" />
      </a>
      <a
        href="/privacy"
        class={`mobile-nav-link flex items-center justify-between px-3 py-2 rounded-lg hover:bg-slate-100 dark:hover:bg-[#181818] hover:text-slate-900 dark:hover:text-white transition-colors ${isPrivacy ? 'text-red-600 dark:text-red-500 font-semibold bg-red-50/50 dark:bg-red-950/20' : ''}`}
      >
        <span>Privacy Policy</span>
        <ArrowRight className="w-3.5 h-3.5 text-slate-400" />
      </a>
      <a
        href="/terms"
        class={`mobile-nav-link flex items-center justify-between px-3 py-2 rounded-lg hover:bg-slate-100 dark:hover:bg-[#181818] hover:text-slate-900 dark:hover:text-white transition-colors ${isTerms ? 'text-red-600 dark:text-red-500 font-semibold bg-red-50/50 dark:bg-red-950/20' : ''}`}
      >
        <span>Terms and Conditions</span>
        <ArrowRight className="w-3.5 h-3.5 text-slate-400" />
      </a>
      <a
        href={isHome ? '#faq' : '/#faq'}
        class="mobile-nav-link flex items-center justify-between px-3 py-2 rounded-lg hover:bg-slate-100 dark:hover:bg-[#181818] hover:text-slate-900 dark:hover:text-white transition-colors"
      >
        <span>FAQ & Guides</span>
        <ArrowRight className="w-3.5 h-3.5 text-slate-400" />
      </a>
    </div>

    <div class="pt-2 border-t border-slate-100 dark:border-[#222222]">
      <a
        href={isHome ? '#analyzer' : '/#analyzer'}
        class="mobile-nav-link w-full flex items-center justify-center py-2.5 rounded-xl bg-red-600 active:bg-red-700 text-white text-xs font-semibold tracking-wide shadow-md shadow-red-950/20"
      >
        Calculate Playlist Now
      </a>
    </div>
  </div>
</header>

<script is:inline>
  // Theme toggle handler
  const toggleBtn = document.getElementById('theme-toggle');
  if (toggleBtn) {
    toggleBtn.addEventListener('click', () => {
      const isDark = document.documentElement.classList.toggle('dark');
      try {
        localStorage.setItem('theme', isDark ? 'dark' : 'light');
        const meta = document.getElementById('theme-color-meta');
        if (meta) {
          meta.setAttribute('content', isDark ? '#0F0F0F' : '#FFFFFF');
        }
      } catch (e) {}
    });
  }

  // Mobile menu toggle handler
  const mobileMenuToggle = document.getElementById('mobile-menu-toggle');
  const mobileMenu = document.getElementById('mobile-menu');
  const menuIconOpen = document.getElementById('menu-icon-open');
  const menuIconClose = document.getElementById('menu-icon-close');

  if (mobileMenuToggle && mobileMenu) {
    const toggleMenu = () => {
      const isOpen = !mobileMenu.classList.contains('hidden');
      if (isOpen) {
        mobileMenu.classList.add('hidden');
        menuIconOpen?.classList.remove('hidden');
        menuIconClose?.classList.add('hidden');
        mobileMenuToggle.setAttribute('aria-expanded', 'false');
      } else {
        mobileMenu.classList.remove('hidden');
        menuIconOpen?.classList.add('hidden');
        menuIconClose?.classList.remove('hidden');
        mobileMenuToggle.setAttribute('aria-expanded', 'true');
      }
    };

    mobileMenuToggle.addEventListener('click', toggleMenu);

    // Close menu when clicking any nav link
    const links = mobileMenu.querySelectorAll('.mobile-nav-link');
    links.forEach((link) => {
      link.addEventListener('click', () => {
        mobileMenu.classList.add('hidden');
        menuIconOpen?.classList.remove('hidden');
        menuIconClose?.classList.add('hidden');
        mobileMenuToggle.setAttribute('aria-expanded', 'false');
      });
    });
  }
</script>
