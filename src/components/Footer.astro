---
import { Play } from 'lucide-react';
---

<footer class="w-full border-t border-slate-200 dark:border-[#272727] bg-slate-100/70 dark:bg-[#0A0A0A] text-slate-500 dark:text-[#717171] text-xs py-12 px-4 transition-colors duration-150">
  <div class="max-w-7xl mx-auto flex flex-col md:flex-row items-center justify-between gap-6">
    <div class="flex flex-col items-center md:items-start space-y-1">
      <div class="flex items-center space-x-2 text-slate-900 dark:text-white font-bold text-sm tracking-tight">
        <div class="w-6 h-6 rounded-lg bg-red-600 flex items-center justify-center">
          <Play className="w-3.5 h-3.5 text-white fill-white ml-0.5" />
        </div>
        <span>YouTube Playlist Length Analyser</span>
      </div>
      <p class="text-[11px] text-slate-500 dark:text-[#AAAAAA]">
        A modern, fast web utility built with Astro, Tailwind CSS v4, and React Islands.
      </p>
    </div>

    <div class="flex items-center space-x-6 text-[11px] font-mono">
      <a href="#analyzer" class="hover:text-slate-900 dark:hover:text-white transition-colors">Analyzer</a>
      <a href="#faq" class="hover:text-slate-900 dark:hover:text-white transition-colors">FAQ</a>
      <a
        href="https://github.com/sharatsachin/ytplaylist-len"
        target="_blank"
        rel="noopener noreferrer"
        class="hover:text-slate-900 dark:hover:text-white transition-colors"
      >
        Reference Architecture
      </a>
      <a
        href="https://developers.google.com/youtube/v3"
        target="_blank"
        rel="noopener noreferrer"
        class="hover:text-slate-900 dark:hover:text-white transition-colors"
      >
        YouTube API v3
      </a>
    </div>

    <div class="text-[10px] text-slate-400 dark:text-[#525252] text-center md:text-right">
      <span>Not affiliated with YouTube or Google LLC.</span>
      <div class="mt-0.5">YouTube is a registered trademark of Google LLC.</div>
    </div>
  </div>
</footer>
