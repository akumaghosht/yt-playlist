---
import { Play, ArrowUpRight, ShieldCheck, Mail, Info, FileText, Heart } from 'lucide-react';
---

<footer class="w-full border-t border-slate-200 dark:border-[#272727] bg-slate-100/70 dark:bg-[#0A0A0A] text-slate-500 dark:text-[#717171] text-xs pt-12 pb-[calc(2.5rem+env(safe-area-inset-bottom,0px))] px-4 transition-colors duration-150">
  <div class="max-w-7xl mx-auto space-y-10">
    {/* Multi-Column Main Footer Grid */}
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-12 gap-8 lg:gap-10">
      {/* Brand & Purpose (5 cols) */}
      <div class="lg:col-span-5 space-y-4">
        <a href="/" class="flex items-center space-x-2.5 group">
          <div class="w-8 h-8 rounded-xl bg-gradient-to-br from-red-500 to-red-700 flex items-center justify-center shadow-lg shadow-red-950/20 dark:shadow-red-950/50 group-hover:scale-105 transition-transform shrink-0">
            <Play className="w-4 h-4 text-white fill-white ml-0.5" />
          </div>
          <div class="flex flex-col">
            <span class="text-sm font-extrabold tracking-tight text-slate-900 dark:text-white">
              YT Playlist <span class="text-red-600 dark:text-red-500">Length</span>
            </span>
            <span class="text-[9px] font-mono text-slate-500 dark:text-[#AAAAAA] -mt-0.5 tracking-wider uppercase">
              Analyser & Study Planner
            </span>
          </div>
        </a>

        <p class="text-xs text-slate-600 dark:text-[#AAAAAA] leading-relaxed max-w-sm">
          A high-performance YouTube playlist duration calculator and course planning suite. Calculate exact runtimes across multiple playback speeds, track watched videos, and forecast completion dates.
        </p>

        <div class="flex items-center gap-2 text-[11px] font-mono text-slate-500 dark:text-[#888888]">
          <span>YouTube Data API v3 Active</span>
          <span>&bull;</span>
          <span>Zero Server Logs</span>
        </div>
      </div>

      {/* Pages Navigation (3 cols) */}
      <div class="lg:col-span-3 space-y-3">
        <h3 class="text-xs font-mono font-bold uppercase tracking-wider text-slate-900 dark:text-white">
          Company & Pages
        </h3>
        <ul class="space-y-2 text-xs">
          <li>
            <a
              href="/about"
              class="hover:text-red-600 dark:hover:text-red-400 transition-colors inline-flex items-center gap-1.5"
            >
              <Info className="w-3.5 h-3.5 text-slate-400 dark:text-[#717171]" />
              <span>About Us</span>
            </a>
          </li>
          <li>
            <a
              href="/contact"
              class="hover:text-red-600 dark:hover:text-red-400 transition-colors inline-flex items-center gap-1.5"
            >
              <Mail className="w-3.5 h-3.5 text-slate-400 dark:text-[#717171]" />
              <span>Contact Us</span>
            </a>
          </li>
          <li>
            <a
              href="/privacy"
              class="hover:text-red-600 dark:hover:text-red-400 transition-colors inline-flex items-center gap-1.5"
            >
              <ShieldCheck className="w-3.5 h-3.5 text-slate-400 dark:text-[#717171]" />
              <span>Privacy Policy</span>
            </a>
          </li>
          <li>
            <a
              href="/terms"
              class="hover:text-red-600 dark:hover:text-red-400 transition-colors inline-flex items-center gap-1.5"
            >
              <FileText className="w-3.5 h-3.5 text-slate-400 dark:text-[#717171]" />
              <span>Terms & Conditions</span>
            </a>
          </li>
        </ul>
      </div>

      {/* Tools & Features (2 cols) */}
      <div class="lg:col-span-2 space-y-3">
        <h3 class="text-xs font-mono font-bold uppercase tracking-wider text-slate-900 dark:text-white">
          Tools & Features
        </h3>
        <ul class="space-y-2 text-xs">
          <li>
            <a href="/#analyzer" class="hover:text-red-600 dark:hover:text-red-400 transition-colors">
              Playlist Analyzer
            </a>
          </li>
          <li>
            <a href="/#features" class="hover:text-red-600 dark:hover:text-red-400 transition-colors">
              Playback Speed Matrix
            </a>
          </li>
          <li>
            <a href="/#analyzer" class="hover:text-red-600 dark:hover:text-red-400 transition-colors">
              Schedule Planner
            </a>
          </li>
          <li>
            <a href="/#features" class="hover:text-red-600 dark:hover:text-red-400 transition-colors">
              Range & Progress Sync
            </a>
          </li>
          <li>
            <a href="/#faq" class="hover:text-red-600 dark:hover:text-red-400 transition-colors">
              Knowledge Base & FAQ
            </a>
          </li>
        </ul>
      </div>

      {/* Legal & External (2 cols) */}
      <div class="lg:col-span-2 space-y-3">
        <h3 class="text-xs font-mono font-bold uppercase tracking-wider text-slate-900 dark:text-white">
          External & API
        </h3>
        <ul class="space-y-2 text-xs">
          <li>
            <a
              href="https://developers.google.com/youtube/v3"
              target="_blank"
              rel="noopener noreferrer"
              class="hover:text-red-600 dark:hover:text-red-400 transition-colors inline-flex items-center gap-1"
            >
              <span>YouTube API v3</span>
              <ArrowUpRight className="w-3 h-3" />
            </a>
          </li>
          <li>
            <a
              href="https://policies.google.com/privacy"
              target="_blank"
              rel="noopener noreferrer"
              class="hover:text-red-600 dark:hover:text-red-400 transition-colors inline-flex items-center gap-1"
            >
              <span>Google Privacy</span>
              <ArrowUpRight className="w-3 h-3" />
            </a>
          </li>
          <li>
            <a
              href="https://www.youtube.com/t/terms"
              target="_blank"
              rel="noopener noreferrer"
              class="hover:text-red-600 dark:hover:text-red-400 transition-colors inline-flex items-center gap-1"
            >
              <span>YouTube Terms</span>
              <ArrowUpRight className="w-3 h-3" />
            </a>
          </li>
          <li>
            <a
              href="https://github.com/sharatsachin/ytplaylist-len"
              target="_blank"
              rel="noopener noreferrer"
              class="hover:text-red-600 dark:hover:text-red-400 transition-colors inline-flex items-center gap-1"
            >
              <span>GitHub Repo</span>
              <ArrowUpRight className="w-3 h-3" />
            </a>
          </li>
        </ul>
      </div>
    </div>

    {/* Bottom Copyright & Disclaimer */}
    <div class="pt-6 border-t border-slate-200 dark:border-[#222222] flex flex-col md:flex-row items-center justify-between gap-4 text-center md:text-left text-[11px] text-slate-500 dark:text-[#717171]">
      <div class="space-y-1">
        <p>
          &copy; {new Date().getFullYear()} YouTube Playlist Length Analyser. All rights reserved.
        </p>
        <p class="text-[10px] text-slate-400 dark:text-[#525252]">
          Not affiliated with, sponsored by, or endorsed by YouTube or Google LLC. YouTube is a registered trademark of Google LLC.
        </p>
      </div>

      <div class="flex items-center gap-4 text-xs font-mono">
        <a href="/privacy" class="hover:text-slate-900 dark:hover:text-white transition-colors">Privacy</a>
        <span>&bull;</span>
        <a href="/terms" class="hover:text-slate-900 dark:hover:text-white transition-colors">Terms</a>
        <span>&bull;</span>
        <a href="/contact" class="hover:text-slate-900 dark:hover:text-white transition-colors">Contact</a>
        <span>&bull;</span>
        <a href="/about" class="hover:text-slate-900 dark:hover:text-white transition-colors">About</a>
      </div>
    </div>
  </div>
</footer>
