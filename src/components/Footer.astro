    <div class="flex flex-col items-center md:items-start space-y-1">
      <div class="flex items-center space-x-2 text-white font-bold text-sm tracking-tight">
        <div class="w-6 h-6 rounded-lg bg-red-600 flex items-center justify-center">
          <svg class="w-3.5 h-3.5 text-white fill-current ml-0.5" viewBox="0 0 24 24">
            <path d="M8 5v14l11-7z"/>
