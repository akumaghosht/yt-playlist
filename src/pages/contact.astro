---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import { ContactForm } from '../components/react/ContactForm';
import { Mail, MessageCircle, HelpCircle, Key, ShieldCheck, Clock, Github, ExternalLink } from 'lucide-react';
---

<Layout
  title="Contact Us | YouTube Playlist Length Checker"
  description="Contact the YouTube Playlist Length Checker team for bug reports, API questions, feature suggestions, or assistance."
>
  <Navbar />

  <main class="flex-1 w-full max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 py-8 sm:py-12 space-y-10 sm:space-y-12">
    {/* Breadcrumbs & Header */}
    <div class="space-y-3">
      <nav class="flex items-center space-x-2 text-xs font-mono text-slate-500 dark:text-[#AAAAAA]">
        <a href="/" class="hover:text-red-600 dark:hover:text-red-500 transition-colors">Home</a>
        <span>/</span>
        <span class="text-slate-900 dark:text-white">Contact Us</span>
      </nav>

      <div class="space-y-2">
        <div class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full bg-red-50 dark:bg-red-950/60 border border-red-200 dark:border-red-900/40 text-red-600 dark:text-red-400 text-xs font-mono font-medium">
          <MessageCircle className="w-3.5 h-3.5" />
          <span>Support & Feedback</span>
        </div>
        <h1 class="text-3xl sm:text-4xl md:text-5xl font-extrabold tracking-tight text-slate-900 dark:text-white">
          We'd Love to <span class="text-red-600 dark:text-red-500">Hear From You</span>
        </h1>
        <p class="text-xs sm:text-sm md:text-base text-slate-600 dark:text-[#AAAAAA] max-w-2xl leading-relaxed">
          Need help troubleshooting an unrecognized playlist, have a feature request for the speed matrix, or want to discuss integration? Get in touch with our team.
        </p>
      </div>
    </div>

    {/* Content Split: Form & Contact Info */}
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-start">
      {/* Left Column: Interactive Contact Form (7 cols) */}
      <div class="lg:col-span-7">
        <ContactForm client:load />
      </div>

      {/* Right Column: Direct Info Cards & FAQ Shortcuts (5 cols) */}
      <div class="lg:col-span-5 space-y-4">
        {/* Support Channels Card */}
        <div class="p-5 sm:p-6 rounded-2xl bg-white dark:bg-[#181818] border border-slate-200 dark:border-[#272727] shadow-sm space-y-4">
          <h2 class="text-sm font-bold text-slate-900 dark:text-white tracking-tight flex items-center gap-2">
            <Mail className="w-4 h-4 text-red-600 dark:text-red-500" />
            <span>Direct Support Channels</span>
          </h2>

          <div class="space-y-3 text-xs">
            <div class="p-3 rounded-xl bg-slate-50 dark:bg-[#202020] border border-slate-100 dark:border-[#2a2a2a] space-y-1">
              <span class="text-[10px] uppercase font-mono tracking-wider text-slate-400 dark:text-[#888888]">
                Support & Inquiries
              </span>
              <div class="font-medium text-slate-900 dark:text-white select-all">
                support@youtubeplaylistlengthcheck.com
              </div>
            </div>

            <div class="p-3 rounded-xl bg-slate-50 dark:bg-[#202020] border border-slate-100 dark:border-[#2a2a2a] space-y-1">
              <span class="text-[10px] uppercase font-mono tracking-wider text-slate-400 dark:text-[#888888]">
                Response Window
              </span>
              <div class="flex items-center gap-1.5 text-slate-700 dark:text-[#CCCCCC]">
                <Clock className="w-3.5 h-3.5 text-emerald-500" />
                <span>Typically under 24 hours on business days</span>
              </div>
            </div>
          </div>
        </div>

        {/* Quick Resolution & Knowledge Base */}
        <div class="p-5 sm:p-6 rounded-2xl bg-white dark:bg-[#181818] border border-slate-200 dark:border-[#272727] shadow-sm space-y-4">
          <h2 class="text-sm font-bold text-slate-900 dark:text-white tracking-tight flex items-center gap-2">
            <HelpCircle className="w-4 h-4 text-red-600 dark:text-red-500" />
            <span>Common Questions & Solutions</span>
          </h2>

          <div class="space-y-3 text-xs text-slate-600 dark:text-[#AAAAAA]">
            <div class="space-y-1">
              <h3 class="font-semibold text-slate-900 dark:text-white">
                1. Why does my playlist say "Unavailable Videos"?
              </h3>
              <p class="leading-relaxed">
                YouTube hides private, deleted, or region-blocked videos from the public API. Our analyzer counts and labels them in the breakdown so your study total reflects playable content.
              </p>
            </div>

            <div class="space-y-1 pt-2 border-t border-slate-100 dark:border-[#222222]">
              <h3 class="font-semibold text-slate-900 dark:text-white">
                2. Seeing "API Quota Exceeded"?
              </h3>
              <p class="leading-relaxed">
                Click the Key icon in the Analyzer to insert your personal free Google YouTube Data API v3 key for unlimited daily queries.
              </p>
            </div>
          </div>

          <div class="pt-2">
            <a
              href="/#faq"
              class="inline-flex items-center gap-1.5 text-xs font-semibold text-red-600 dark:text-red-400 hover:text-red-700 dark:hover:text-red-300 transition-colors"
            >
              <span>Visit Full Knowledge Base & FAQ</span>
              <ExternalLink className="w-3 h-3" />
            </a>
          </div>
        </div>

        {/* Privacy Note Card */}
        <div class="p-4 rounded-xl bg-slate-50 dark:bg-[#151515] border border-slate-200 dark:border-[#222222] flex items-start gap-3 text-xs text-slate-600 dark:text-[#AAAAAA]">
          <ShieldCheck className="w-4 h-4 text-emerald-500 shrink-0 mt-0.5" />
          <p class="leading-relaxed">
            Your contact submission is strictly used to reply to your inquiry. We never send spam, newsletter pitches, or share data with marketers. Read our <a href="/privacy" class="underline hover:text-slate-900 dark:hover:text-white">Privacy Policy</a>.
          </p>
        </div>
      </div>
    </div>
  </main>

  <Footer />
</Layout>

