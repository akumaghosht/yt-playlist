---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import {
  ShieldAlert,
  Home,
  ArrowLeft,
  Lock,
  Key,
  HelpCircle,
  Mail,
  Copy,
  ArrowRight,
  EyeOff,
  Play
} from 'lucide-react';
---

<Layout
  title="403: Access Forbidden | YouTube Playlist Length Checker"
  description="Access forbidden. Learn why playlist access may be restricted, how to analyze unlisted or private YouTube playlists, and how to verify your API settings."
  robots="noindex, nofollow"
>
  <Navbar />

  <main class="flex-1 w-full max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-10 sm:py-16 space-y-10 sm:space-y-12">
    {/* Breadcrumbs */}
    <nav class="flex items-center space-x-2 text-xs font-mono text-slate-500 dark:text-[#AAAAAA]">
      <a href="/" class="hover:text-red-600 dark:hover:text-red-500 transition-colors">Home</a>
      <span>/</span>
      <span class="text-slate-900 dark:text-white font-semibold">403 Forbidden</span>
    </nav>

    {/* Hero Section */}
    <section class="text-center space-y-6 pt-2 pb-4">
      {/* Visual Error Code & Icon */}
      <div class="inline-flex items-center justify-center relative">
        <div class="absolute -inset-4 bg-red-600/10 dark:bg-red-600/20 rounded-full blur-2xl pointer-events-none"></div>

        <div class="relative flex flex-col items-center">
          <div class="w-16 h-16 sm:w-20 sm:h-20 rounded-2xl bg-red-50 dark:bg-red-950/60 border border-red-200 dark:border-red-900/40 text-red-600 dark:text-red-400 flex items-center justify-center shadow-lg shadow-red-950/10 mb-4">
            <ShieldAlert className="w-8 h-8 sm:w-10 sm:h-10" />
          </div>
          <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-slate-100 dark:bg-[#1f1f1f] border border-slate-200 dark:border-[#333333] text-[11px] font-mono font-medium text-slate-600 dark:text-[#AAAAAA]">
            <span class="w-2 h-2 rounded-full bg-red-600"></span>
            <span>HTTP STATUS 403 • ACCESS_RESTRICTED</span>
          </div>
        </div>
      </div>

      <div class="space-y-3 max-w-2xl mx-auto">
        <h1 class="text-3xl sm:text-5xl font-extrabold tracking-tight text-slate-900 dark:text-white">
          Access <span class="text-red-600 dark:text-red-500">Restricted</span>
        </h1>
        <p class="text-sm sm:text-base text-slate-600 dark:text-[#AAAAAA] leading-relaxed">
          You don't have permission to access the requested resource or playlist. This typically occurs when a playlist is set to Private or your API credentials lack the required scopes.
        </p>
      </div>

      {/* Primary Actions */}
      <div class="flex flex-wrap items-center justify-center gap-3 pt-2">
        <a
          href="/"
          class="inline-flex items-center gap-2 px-6 py-2.5 rounded-full bg-red-600 hover:bg-red-500 active:bg-red-700 text-white text-xs sm:text-sm font-semibold transition-colors shadow-md shadow-red-950/20"
        >
          <Home className="w-4 h-4" />
          <span>Return to Homepage</span>
        </a>

        <button
          id="go-back-btn"
          type="button"
          class="inline-flex items-center gap-2 px-5 py-2.5 rounded-full bg-white dark:bg-[#181818] hover:bg-slate-50 dark:hover:bg-[#222222] border border-slate-200 dark:border-[#272727] text-slate-700 dark:text-[#CCCCCC] text-xs sm:text-sm font-semibold transition-colors cursor-pointer"
        >
          <ArrowLeft className="w-4 h-4" />
          <span>Previous Page</span>
        </button>
      </div>
    </section>

    {/* Guided Explanations & Solutions */}
    <section class="space-y-4">
      <div class="flex items-center gap-2">
        <Lock className="w-4 h-4 text-red-600 dark:text-red-400" />
        <h2 class="text-sm font-bold text-slate-900 dark:text-white uppercase tracking-wider font-mono">
          Why Did This Happen?
        </h2>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
        {/* Solution 1: Private vs Unlisted */}
        <div class="p-5 rounded-2xl bg-white dark:bg-[#181818] border border-slate-200 dark:border-[#272727] shadow-sm space-y-3 flex flex-col justify-between">
          <div class="space-y-2">
            <div class="w-8 h-8 rounded-lg bg-red-50 dark:bg-red-950/50 text-red-600 dark:text-red-400 flex items-center justify-center">
              <EyeOff className="w-4 h-4" />
            </div>
            <h3 class="text-xs sm:text-sm font-bold text-slate-900 dark:text-white">Private Playlist Setting</h3>
            <p class="text-xs text-slate-500 dark:text-[#888888] leading-relaxed">
              YouTube's API cannot read playlists set to <strong>Private</strong>. Change the privacy setting in YouTube Studio to <strong>Unlisted</strong> to calculate it privately.
            </p>
          </div>
          <div class="pt-2 border-t border-slate-100 dark:border-[#222222]">
            <a
              href="/#faq"
              class="inline-flex items-center gap-1 text-xs font-semibold text-red-600 dark:text-red-400 hover:underline"
            >
              <span>Learn About Privacy</span>
              <ArrowRight className="w-3 h-3" />
            </a>
          </div>
        </div>

        {/* Solution 2: Custom API Key Restrictions */}
        <div class="p-5 rounded-2xl bg-white dark:bg-[#181818] border border-slate-200 dark:border-[#272727] shadow-sm space-y-3 flex flex-col justify-between">
          <div class="space-y-2">
            <div class="w-8 h-8 rounded-lg bg-red-50 dark:bg-red-950/50 text-red-600 dark:text-red-400 flex items-center justify-center">
              <Key className="w-4 h-4" />
            </div>
            <h3 class="text-xs sm:text-sm font-bold text-slate-900 dark:text-white">API Key Restrictions</h3>
            <p class="text-xs text-slate-500 dark:text-[#888888] leading-relaxed">
              If using a personal YouTube API key in Settings, verify in Google Cloud Console that "YouTube Data API v3" is enabled and HTTP referrers are allowed.
            </p>
          </div>
          <div class="pt-2 border-t border-slate-100 dark:border-[#222222]">
            <a
              href="/#analyzer"
              class="inline-flex items-center gap-1 text-xs font-semibold text-red-600 dark:text-red-400 hover:underline"
            >
              <span>Check Key in Settings</span>
              <ArrowRight className="w-3 h-3" />
            </a>
          </div>
        </div>

        {/* Solution 3: Contact Support */}
        <div class="p-5 rounded-2xl bg-white dark:bg-[#181818] border border-slate-200 dark:border-[#272727] shadow-sm space-y-3 flex flex-col justify-between">
          <div class="space-y-2">
            <div class="w-8 h-8 rounded-lg bg-red-50 dark:bg-red-950/50 text-red-600 dark:text-red-400 flex items-center justify-center">
              <Mail className="w-4 h-4" />
            </div>
            <h3 class="text-xs sm:text-sm font-bold text-slate-900 dark:text-white">Need Assistance?</h3>
            <p class="text-xs text-slate-500 dark:text-[#888888] leading-relaxed">
              If you believe this block is in error or your legitimate playlist cannot be resolved, contact our support team.
            </p>
          </div>
          <div class="pt-2 border-t border-slate-100 dark:border-[#222222]">
            <a
              href="/contact"
              class="inline-flex items-center gap-1 text-xs font-semibold text-red-600 dark:text-red-400 hover:underline"
            >
              <span>Contact Support</span>
              <ArrowRight className="w-3 h-3" />
            </a>
          </div>
        </div>
      </div>
    </section>

    {/* Technical Diagnostic Details */}
    <section class="p-5 rounded-2xl bg-slate-50 dark:bg-[#141414] border border-slate-200 dark:border-[#222222] space-y-3 text-xs">
      <div class="flex items-center justify-between">
        <span class="font-mono text-slate-500 dark:text-[#888888] text-[11px] uppercase tracking-wider font-semibold">
          Access Log Details
        </span>
        <button
          id="copy-diag-btn"
          type="button"
          class="inline-flex items-center gap-1 px-2.5 py-1 rounded-lg bg-white dark:bg-[#202020] border border-slate-200 dark:border-[#333333] hover:text-slate-900 dark:hover:text-white text-[11px] font-mono text-slate-600 dark:text-[#AAAAAA] transition-colors cursor-pointer"
        >
          <Copy className="w-3 h-3" />
          <span id="copy-diag-text">Copy Details</span>
        </button>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 gap-2 text-[11px] font-mono">
        <div class="p-2.5 rounded-lg bg-white dark:bg-[#1a1a1a] border border-slate-200 dark:border-[#262626] overflow-hidden">
          <span class="text-slate-400 dark:text-[#666666] block text-[10px]">Resource URL</span>
          <span id="resource-url" class="text-slate-800 dark:text-[#DDDDDD] truncate block">Loading...</span>
        </div>
        <div class="p-2.5 rounded-lg bg-white dark:bg-[#1a1a1a] border border-slate-200 dark:border-[#262626] overflow-hidden">
          <span class="text-slate-400 dark:text-[#666666] block text-[10px]">Status</span>
          <span class="text-red-600 dark:text-red-400 font-bold block">403 Forbidden / Not Authorized</span>
        </div>
      </div>
    </section>
  </main>

  <Footer />
</Layout>

<script is:inline>
  try {
    const urlEl = document.getElementById('resource-url');
    if (urlEl) urlEl.textContent = window.location.href;
  } catch (e) {}

  const backBtn = document.getElementById('go-back-btn');
  if (backBtn) {
    backBtn.addEventListener('click', () => {
      if (window.history.length > 1) {
        window.history.back();
      } else {
        window.location.href = '/';
      }
    });
  }

  const copyBtn = document.getElementById('copy-diag-btn');
  const copyText = document.getElementById('copy-diag-text');
  if (copyBtn && copyText) {
    copyBtn.addEventListener('click', async () => {
      const details = `Access Forbidden Report (403):\nURL: ${window.location.href}\nTime: ${new Date().toISOString()}`;
      try {
        await navigator.clipboard.writeText(details);
        copyText.textContent = 'Copied!';
        setTimeout(() => {
          copyText.textContent = 'Copy Details';
        }, 2000);
      } catch (err) {
        copyText.textContent = 'Copy failed';
      }
    });
  }
</script>

